    {"if": "any_stress_label_ELEVATED", "care_need": "MEDIUM_HIGH", "inspection_need": "CONDITIONAL"},
    {"if": "two_or_more_CAUTION", "care_need": "MEDIUM", "inspection_need": "NONE_OR_CONDITIONAL"},
    {"if": "one_CAUTION", "care_need": "LOW_MEDIUM", "inspection_need": "NONE"},
    {"if": "all_LOW", "care_need": "LOW", "inspection_need": "NONE"}
