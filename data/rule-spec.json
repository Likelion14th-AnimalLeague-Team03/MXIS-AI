  "purpose": "Deterministic rule/scoring specification for MXIS luxury bag AI care. Produces preventive material-aware exposure tiers, care actions, and inspection decisions without unsupported damage probabilities.",
  "preventive_tier_policy": [
    "Do not use accelerated-ageing damage observations directly as everyday handbag thresholds.",
    "Use conservation and paper-derived damage-supporting bands as upper-bound evidence.",
    "Warn before visible deformation or damage is expected.",
    "Reserve INSPECTION_REQUIRED for visible symptoms or hard triggers."
  ],
  "materials": [
    "coated_cowhide",
    "natural_leather",
    "suede",
    "canvas"
  ],
  "risk_factors": [
    "humidity",
    "temperature_heat",
    "dryness",
    "uv_light",
    "physical_shock_abrasion",
    "continuous_usage_rest"
  ],
  "stress_labels": {
    "LOW": "No meaningful exposure or symptom.",
    "CAUTION": "Stable zone breach, short/sustained exposure, or care habit gap requiring preventive correction.",
    "ELEVATED": "Repeated exposure, sensitive material plus direct event, or partial approach to source-backed damage-supporting bands.",
    "HIGH": "Source-backed damage-supporting exposure band reached or very strong exposure; not confirmed damage.",
    "INSPECTION_REQUIRED": "Hard symptom or severe trigger requiring brand/specialist inspection.",
    "UNKNOWN": "Insufficient input."
  },
