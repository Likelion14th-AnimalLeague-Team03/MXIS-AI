  "inspection_triggers": [
    {"trigger_code": "visible_mould", "condition": "visible_mould_reported == true", "severity": "hard", "materials": ["all"], "decision": "INSPECTION_REQUIRED"},
    {"trigger_code": "musty_odour_after_humidity", "condition": "musty_odour_reported == true AND humidity_stress != LOW", "severity": "hard", "materials": ["all"], "decision": "INSPECTION_REQUIRED"},
    {"trigger_code": "water_stain_natural_or_suede", "condition": "water_stain_reported == true", "severity": "hard", "materials": ["natural_leather", "suede"], "decision": "INSPECTION_REQUIRED"},
    {"trigger_code": "sticky_tacky_coating", "condition": "sticky_or_tacky_coating_reported == true", "severity": "hard", "materials": ["coated_cowhide", "coated_canvas", "patent_or_glossy_finish"], "decision": "INSPECTION_REQUIRED"},
    {"trigger_code": "blistering_after_moisture", "condition": "blistering_reported == true", "severity": "hard", "materials": ["coated_cowhide", "coated_canvas"], "decision": "INSPECTION_REQUIRED"},
    {"trigger_code": "active_cracking", "condition": "cracking_reported == true", "severity": "hard", "materials": ["coated_cowhide", "natural_leather", "suede", "canvas_with_leather_trim"], "decision": "INSPECTION_REQUIRED"},
    {"trigger_code": "powdery_surface", "condition": "powdery_surface_reported == true", "severity": "hard", "materials": ["coated_cowhide", "natural_leather", "suede"], "decision": "INSPECTION_REQUIRED"},
    {"trigger_code": "nap_matting_after_wet", "condition": "nap_matting_reported == true AND wet_event_reported == true", "severity": "hard", "materials": ["suede", "nubuck"], "decision": "INSPECTION_REQUIRED"},
